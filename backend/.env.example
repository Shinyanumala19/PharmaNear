# PharmaNear Backend Environment Configuration Example
PORT=5000
SECRET_KEY=your-production-secret-key-change-me

# Database Configuration:
# - Leave empty to use default local SQLite database in instance/pharmanear.db
# - Or provide your Render PostgreSQL connection string:
#   DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# Frontend URL (Deployed on Vercel) for strict CORS configuration:
# e.g., https://your-pharmanear-frontend.vercel.app
# If omitted or left empty, all origins (*) are permitted
FRONTEND_URL=

# Optional: Google Gemini API Key for AI OCR prescription scanning and medical consultation
# If empty, PharmaNear's built-in intelligent clinical pharmacology engine operates automatically
GEMINI_API_KEY=
